<?xml version="1.0" encoding="utf-8"?>
<!-- The app's Bento tile, reproduced for the home screen: same background,
     same radius. The widget is a piece of the app that happens to live
     outside it, and it should look like one. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#1C1C1E" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="#2B2B2D" />
</shape>
